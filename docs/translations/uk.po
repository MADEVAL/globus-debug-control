#: include/trait-admin-settings.php:91
msgid "Plugin status"
msgstr "Стан плагіна"

#: include/trait-admin-settings.php:92
msgid "Turn all debug control behaviour on or off."
msgstr "Увімкнути або вимкнути всю поведінку контролю налагодження."

#: include/trait-admin-settings.php:95
msgid "Error filtering"
msgstr "Фільтрування помилок"

#: include/trait-admin-settings.php:96
msgid "Choose which PHP error types are hidden and how errors are displayed."
msgstr "Виберіть, які типи помилок PHP приховуються і як помилки відображаються."

#: include/trait-admin-settings.php:99
msgid "Logging"
msgstr "Журналювання"

#: include/trait-admin-settings.php:100
msgid "Write errors to a file and rotate it when it grows too large."
msgstr "Записувати помилки у файл і ротувати його, коли він стає завеликим."

#: include/trait-admin-settings.php:103
msgid "Display and API contexts"
msgstr "Відображення та контексти API"

#: include/trait-admin-settings.php:104
msgid "Front-end cosmetics and non-HTML request handling."
msgstr "Косметика фронтенду та обробка запитів, відмінних від HTML."

#: include/trait-admin-settings.php:107
msgid "Early interception"
msgstr "Раннє перехоплення"

#: include/trait-admin-settings.php:108
msgid "Load the error filter before regular plugins."
msgstr "Завантажувати фільтр помилок раніше за звичайні плагіни."

#: include/trait-admin-settings.php:156
msgid "Save Settings"
msgstr "Зберегти налаштування"

#: include/trait-admin-settings.php:230
msgid "Enable debug control"
msgstr "Увімкнути контроль налагодження"

#: include/trait-admin-settings.php:232
msgid "When disabled, the plugin does not affect PHP or WordPress settings."
msgstr "Якщо вимкнено, плагін не впливає на налаштування PHP чи WordPress."

#: include/trait-admin-settings.php:246
msgid "Suppress E_NOTICE"
msgstr "Пригнічувати E_NOTICE"

#: include/trait-admin-settings.php:246
msgid "and E_USER_NOTICE"
msgstr "та E_USER_NOTICE"

#: include/trait-admin-settings.php:250
msgid "Suppress E_DEPRECATED"
msgstr "Пригнічувати E_DEPRECATED"

#: include/trait-admin-settings.php:250
msgid "and E_USER_DEPRECATED"
msgstr "та E_USER_DEPRECATED"

#: include/trait-admin-settings.php:254
msgid "Suppress E_WARNING"
msgstr "Пригнічувати E_WARNING"

#: include/trait-admin-settings.php:254
msgid "and E_USER_WARNING (use with caution!)"
msgstr "та E_USER_WARNING (використовуйте обережно!)"

#: include/trait-admin-settings.php:259
#: include/trait-admin-settings.php:264
msgid "Suppress E_STRICT"
msgstr "Пригнічувати E_STRICT"

#: include/trait-admin-settings.php:264
msgid "(not available in PHP 8.0+)"
msgstr "(недоступно в PHP 8.0+)"

#: include/trait-admin-settings.php:268
msgid "Selected error types will not be displayed or logged. Fatal errors (E_ERROR) are always visible."
msgstr "Вибрані типи помилок не відображатимуться і не журналюватимуться. Фатальні помилки (E_ERROR) завжди видимі."

#: include/trait-admin-settings.php:279
msgid "Inherit from WP_DEBUG_DISPLAY"
msgstr "Успадковувати від WP_DEBUG_DISPLAY"

#: include/trait-admin-settings.php:280
msgid "Always on"
msgstr "Завжди увімкнено"

#: include/trait-admin-settings.php:281
msgid "Always off"
msgstr "Завжди вимкнено"

#: include/trait-admin-settings.php:283
msgid "Controls error output on screen. In API contexts, display is automatically disabled."
msgstr "Керує виведенням помилок на екран. У контекстах API відображення вимикається автоматично."

#: include/trait-admin-settings.php:296
msgid "Enable error logging"
msgstr "Увімкнути журналювання помилок"

#: include/trait-admin-settings.php:300
msgid "Leave empty for auto-detection"
msgstr "Залиште порожнім для автовизначення"

#: include/trait-admin-settings.php:301
msgid "If empty: uses WP_DEBUG_LOG (usually wp-content/debug.log)."
msgstr "Якщо порожньо: використовується WP_DEBUG_LOG (зазвичай wp-content/debug.log)."

#: include/trait-admin-settings.php:301
msgid "You can specify an absolute or relative (from wp-content) path."
msgstr "Можна вказати абсолютний шлях або відносний (від wp-content)."

#: include/trait-admin-settings.php:303
msgid "Maximum log size (MB):"
msgstr "Максимальний розмір журналу (МБ):"

#: include/trait-admin-settings.php:305
msgid "When exceeded, the file will be renamed with a date suffix and a new one created. Range: 1-100 MB."
msgstr "Після перевищення файл буде перейменовано з суфіксом дати і створено новий. Діапазон: 1-100 МБ."

#. translators: 1: CSS class name, 2: HTML tag name
#: include/trait-admin-settings.php:322
#, php-format
msgid "Remove %1$s class from %2$s"
msgstr "Видалити клас %1$s з %2$s"

#: include/trait-admin-settings.php:330
msgid "WordPress adds this class when errors are detected. It can interfere with styling."
msgstr "WordPress додає цей клас, коли виявлено помилки. Він може заважати стилізації."

#: include/trait-admin-settings.php:342
msgid "Show errors in API contexts"
msgstr "Показувати помилки в контекстах API"

