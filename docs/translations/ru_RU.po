#: globus-debug-control.php:3 include/ui/partials/header.php:22
msgid "GLOBUS Debug Control"
msgstr "GLOBUS Debug Control"

#. Plugin URI of the plugin
#: globus-debug-control.php:4
msgid "https://globus.studio"
msgstr "https://globus.studio"

#. Description of the plugin
#: globus-debug-control.php:5
msgid ""
"Full WordPress debug mode control: error type filtering, display and logging"
" management, php-error body class removal."
msgstr ""
"Полный контроль режима отладки WordPress: фильтрация типов ошибок, "
"управление выводом и логированием, удаление класса body php-error."

