#: include/trait-admin-settings.php:92
msgid "Turn all debug control behaviour on or off."
msgstr "Включает или отключает всё поведение управления отладкой."

#: include/trait-admin-settings.php:95
msgid "Error filtering"
msgstr "Фильтрация ошибок"

#: include/trait-admin-settings.php:96
msgid "Choose which PHP error types are hidden and how errors are displayed."
msgstr "Выберите, какие типы ошибок PHP скрывать и как отображать ошибки."

#: include/trait-admin-settings.php:99
msgid "Logging"
msgstr "Логирование"

#: include/trait-admin-settings.php:100
msgid "Write errors to a file and rotate it when it grows too large."
msgstr "Записывать ошибки в файл и ротировать его при превышении размера."

#: include/trait-admin-settings.php:103
msgid "Display and API contexts"
msgstr "Отображение и контексты API"

#: include/trait-admin-settings.php:104
msgid "Front-end cosmetics and non-HTML request handling."
msgstr "Косметика фронтенда и обработка не-HTML запросов."

#: include/trait-admin-settings.php:107
msgid "Early interception"
msgstr "Ранний перехват"

#: include/trait-admin-settings.php:108
msgid "Load the error filter before regular plugins."
msgstr "Загружать фильтр ошибок раньше обычных плагинов."

#: include/trait-admin-settings.php:156
msgid "Save Settings"
msgstr "Сохранить настройки"

#: include/trait-admin-settings.php:230
msgid "Enable debug control"
msgstr "Включить управление отладкой"

#: include/trait-admin-settings.php:232
msgid "When disabled, the plugin does not affect PHP or WordPress settings."
msgstr "Когда управление отключено, плагин не влияет на настройки PHP и WordPress."

#: include/trait-admin-settings.php:246
msgid "Suppress E_NOTICE"
msgstr "Подавлять E_NOTICE"

#: include/trait-admin-settings.php:246
msgid "and E_USER_NOTICE"
msgstr "и E_USER_NOTICE"

#: include/trait-admin-settings.php:250
msgid "Suppress E_DEPRECATED"
msgstr "Подавлять E_DEPRECATED"

#: include/trait-admin-settings.php:250
msgid "and E_USER_DEPRECATED"
msgstr "и E_USER_DEPRECATED"

#: include/trait-admin-settings.php:254
msgid "Suppress E_WARNING"
msgstr "Подавлять E_WARNING"

#: include/trait-admin-settings.php:254
msgid "and E_USER_WARNING (use with caution!)"
msgstr "и E_USER_WARNING (используйте с осторожностью!)"

#: include/trait-admin-settings.php:259
#: include/trait-admin-settings.php:264
msgid "Suppress E_STRICT"
msgstr "Подавлять E_STRICT"

#: include/trait-admin-settings.php:264
msgid "(not available in PHP 8.0+)"
msgstr "(недоступно в PHP 8.0+)"

#: include/trait-admin-settings.php:268
msgid "Selected error types will not be displayed or logged. Fatal errors (E_ERROR) are always visible."
msgstr "Выбранные типы ошибок не будут отображаться и записываться в журнал. Фатальные ошибки (E_ERROR) всегда видны."

#: include/trait-admin-settings.php:279
msgid "Inherit from WP_DEBUG_DISPLAY"
msgstr "Наследовать из WP_DEBUG_DISPLAY"

#: include/trait-admin-settings.php:280
msgid "Always on"
msgstr "Всегда включено"

#: include/trait-admin-settings.php:281
msgid "Always off"
msgstr "Всегда отключено"

#: include/trait-admin-settings.php:283
msgid "Controls error output on screen. In API contexts, display is automatically disabled."
msgstr "Управляет выводом ошибок на экран. В контекстах API отображение автоматически отключается."

#: include/trait-admin-settings.php:296
msgid "Enable error logging"
msgstr "Включить логирование ошибок"

#: include/trait-admin-settings.php:300
msgid "Leave empty for auto-detection"
msgstr "Оставьте пустым для автоопределения"

#: include/trait-admin-settings.php:301
msgid "If empty: uses WP_DEBUG_LOG (usually wp-content/debug.log)."
msgstr "Если пусто: используется WP_DEBUG_LOG (обычно wp-content/debug.log)."

#: include/trait-admin-settings.php:301
msgid "You can specify an absolute or relative (from wp-content) path."
msgstr "Можно указать абсолютный или относительный (от wp-content) путь."

#: include/trait-admin-settings.php:303
msgid "Maximum log size (MB):"
msgstr "Максимальный размер журнала (МБ):"

#: include/trait-admin-settings.php:305
msgid "When exceeded, the file will be renamed with a date suffix and a new one created. Range: 1-100 MB."
msgstr "При превышении файл будет переименован с суффиксом даты и создан новый. Диапазон: 1-100 МБ."

#. translators: 1: CSS class name, 2: HTML tag name
#: include/trait-admin-settings.php:322
#, php-format
msgid "Remove %1$s class from %2$s"
msgstr "Удалить класс %1$s у %2$s"

#: include/trait-admin-settings.php:330
msgid "WordPress adds this class when errors are detected. It can interfere with styling."
msgstr "WordPress добавляет этот класс при обнаружении ошибок. Он может мешать стилизации."

#: include/trait-admin-settings.php:342
msgid "Show errors in API contexts"
msgstr "Показывать ошибки в контекстах API"

#: include/trait-admin-settings.php:344
msgid "By default, error display is disabled in AJAX, REST API, Cron, and CLI for proper operation."
msgstr "По умолчанию отображение ошибок отключено в AJAX, REST API, Cron и CLI для корректной работы."

#: include/trait-admin-settings.php:344
msgid "Enable only for API debugging."
msgstr "Включайте только для отладки API."

#: include/trait-admin-settings.php:357
msgid "Install mu-plugin for early interception"
msgstr "Установить mu-plugin для раннего перехвата"

#: include/trait-admin-settings.php:362
msgid "Not installed"
msgstr "Не установлен"

#: include/trait-admin-settings.php:365
msgid "WordPress loads plugins alphabetically. Errors from plugins loaded earlier (e.g. Elementor) occur before GLOBUS Debug Control initializes."
msgstr "WordPress загружает плагины в алфавитном порядке. Ошибки из плагинов, загружаемых раньше (например, Elementor), возникают до инициализации GLOBUS Debug Control."

#. translators: 1: mu-plugin filename, 2: directory path
#: include/trait-admin-settings.php:369
