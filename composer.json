{
	"name": "globusstudio/globus-debug-control-dev",
	"description": "Development tooling for the GLOBUS Debug Control plugin",
	"type": "project",
	"require-dev": {
		"dealerdirect/phpcodesniffer-composer-installer": "^1.2",
		"phpunit/phpunit": "^10.0 || ^11.0 || ^12.0",
		"squizlabs/php_codesniffer": "^3.13",
		"wp-coding-standards/wpcs": "^3.3",
		"yoast/phpunit-polyfills": "^2.0 || ^3.0"
	},
	"autoload-dev": {
		"psr-4": {
			"GDC\\Tests\\": "tests/"
		}
	},
	"scripts": {
		"test": "phpunit",
		"cs": "phpcs",
		"cs-fix": "phpcbf"
	},
	"config": {
		"sort-packages": true,
		"allow-plugins": {
			"dealerdirect/phpcodesniffer-composer-installer": true
		}
	}
}
