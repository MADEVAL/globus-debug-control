<?xml version="1.0"?>
<ruleset name="GLOBUS Debug Control">
	<description>PHPCS rules for GLOBUS Debug Control plugin</description>

	<!-- What to scan -->
	<file>globus-debug-control/</file>

	<!-- Exclude generated/vendor/test code -->
	<exclude-pattern>*/vendor/*</exclude-pattern>
	<exclude-pattern>*/tests/*</exclude-pattern>
	<exclude-pattern>*/languages/*</exclude-pattern>
	<exclude-pattern>*/index.php</exclude-pattern>

	<!-- PHP version target -->
	<config name="testVersion" value="7.4-"/>

	<!-- Base standard: WordPress with Docs sniffs excluded (too noisy for a dev plugin) -->
	<rule ref="WordPress">
		<!-- Tabs are fine — WP core uses tabs -->
		<exclude name="Generic.WhiteSpace.DisallowTabIndent"/>

		<!-- Plugin Check / Plugin Review does not require these for private plugins -->
		<exclude name="WordPress.Files.FileName.InvalidClassFileName"/>
		<exclude name="WordPress.Files.FileName.NotHyphenatedLowercase"/>

		<!-- i18n: text domain is enforced below selectively -->
		<exclude name="WordPress.WP.I18n.MissingArgDomain"/>
	</rule>

	<!-- Enforce our text domain -->
	<rule ref="WordPress.WP.I18n">
		<properties>
			<property name="text_domain" type="array">
				<element value="globus-debug-control"/>
			</property>
		</properties>
	</rule>

	<!-- Nonce verification: we ignore it only where intentionally documented -->
	<rule ref="WordPress.Security.NonceVerification"/>

	<!-- Formatting: enforce short array syntax -->
	<rule ref="Generic.Arrays.DisallowLongArraySyntax"/>

	<!-- Tabs for indentation, spaces for alignment -->
	<rule ref="Generic.WhiteSpace.DisallowSpaceIndent"/>
	<rule ref="WordPress.WhiteSpace.OperatorSpacing"/>

</ruleset>
